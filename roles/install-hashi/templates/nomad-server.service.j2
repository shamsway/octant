[Unit]
Description=Nomad server
{% if tailscale_enabled | default(false) %}
Requires=network-online.target tailscaled.service consul-server.service
After=network-online.target tailscaled.service consul-server.service
{% else %}
Requires=network-online.target consul-server.service
After=network-online.target consul-server.service
{% endif %}
Wants=consul.service
After=consul.service
Documentation=https://www.nomadproject.io/docs/agent/options

[Service]
Restart=on-failure
ExecStart=/usr/bin/nomad agent -config={{ configdirs[name] }}
User=root
Group=root
ExecReload=/bin/kill -HUP $MAINPID
KillMode=process
KillSignal=SIGINT
LimitNOFILE=65535
RestartSec=2
StartLimitBurst=3
StartLimitInterval=10
TasksMax=infinity
OOMScoreAdjust=-1000

[Install]
WantedBy=multi-user.target
